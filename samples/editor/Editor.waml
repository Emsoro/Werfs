<?waml version="0.1"?>
<!--
  samples/editor — a multi-document text editor skeleton.

  This is the INTEGRATION page. Every capability the framework grew for real
  applications meets here at once:

    1  MenuBar        File / Edit / View / Help, second- and third-level submenus,
                     live enabled state, and a tab-content font-size setting
    2  CommandBar     New / Open / Save / Close / Reopen + overflow when narrow
    3  TabView        three documents: switch, close (×), new (+), dirty dot
    4  Editor area    a TextBox bound TwoWay to the active document
    5  Status line    path, saved-or-modified, tab count
    6  ContentDialog  "save / discard / cancel" when closing a changed tab
    7  File dialogs   File ▸ Open and Save As are real IFileDialog calls

  Bound to sample::EditorVm in EditorVm.h.

  Three things worth reading the markup for:
   - The dialog at the bottom is declared once and never re-created. Its IsOpen
     and Result are BOUND, so the ViewModel decides when to ask and which button
     won. No dialog object appears in C++.
   - The tab strip's close request is a bindable property, not a callback. The
     control cannot know whether a document has unsaved work; it only reports
     that a close was requested.
   - The outer Grid gives the content region the star row and the three bars
     Auto rows. That is the one place in this page where explicit track sizing is
     clearer than nesting panels.
-->
<Page Background="AppBackground" Padding="0">
  <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="1*">

    <!-- ============ Styles ============ -->
    <!--
      Declared once, high up, so the rest of the page is about WHAT each element
      is rather than how it looks. A style is resolved at LOAD time: a Setter
      naming a property the target type does not have is a load error with a line
      number, not something that silently does nothing at runtime.

      Precedence is local > style > default, so `Style="{StaticResource
      ToolButton}" Margin="0,0,8,0"` on one button tweaks just that button.
    -->
    <ResourceDictionary>
      <!-- Named literals. These are substituted into any attribute or Setter
           before type conversion, so the same name works as a colour, a number
           or a whole thickness. Change the radius once and every card follows. -->
      <Number x:Key="CardRadius">6</Number>
      <Number x:Key="PanelPad">10</Number>
      <Thickness x:Key="StatusPad">14,8,14,8</Thickness>
    </ResourceDictionary>

    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="CardBackground"/>
      <Setter Property="BorderBrush" Value="CardBorder"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    </Style>

    <!-- The editor area: a recessed panel inside the tab content. Derived from
         Surface so the radius and border are declared exactly once. -->
    <Style x:Key="EditorSurface" TargetType="Border" BasedOn="{StaticResource Surface}">
      <Setter Property="Background" Value="ControlFill"/>
      <Setter Property="Padding" Value="{StaticResource PanelPad}"/>
    </Style>

    <Style x:Key="ToolButton" TargetType="AppBarButton">
      <Setter Property="FontSize" Value="12"/>
      <!-- Save is meaningless with no document open. This is a trigger rather than a
           per-command check because it is a purely visual consequence of one property:
           CanSave is false, so the button dims. The command itself still refuses to
           run, so a stale visual can never cause a bad write. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="TextDisabled"/>
      </Trigger>
    </Style>

    <!-- A caption line: the status bar and the per-tab path both use it. -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="TextSecondary"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ 1. Menu bar ============ -->
    <MenuBar Grid.Row="0" Height="34" Background="CardBackground">
      <MenuBarItem Title="File">
        <MenuFlyout>
          <MenuFlyoutItem Text="New"      Hint="Ctrl+N" Command="{Binding NewCommand}"/>
          <MenuFlyoutItem Text="Open…"    Hint="Ctrl+O" Command="{Binding OpenCommand}"/>
          <MenuFlyoutSeparator/>
          <!-- IsEnabled follows CanSave, which the ViewModel recomputes whenever the
               active document changes. Open this menu with no document and Save is
               greyed out: enabled state is read from CanExecute at OPEN time, not
               baked in when the markup was loaded. -->
          <MenuFlyoutItem Text="Save"     Hint="Ctrl+S" Command="{Binding SaveCommand}"/>
          <MenuFlyoutItem Text="Save as…" Hint="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutSubItem Text="Close">
            <MenuFlyout>
              <MenuFlyoutItem Text="Close tab" Hint="Ctrl+W"
                              Command="{Binding CloseTabCommand}"/>
              <MenuFlyoutItem Text="Reopen last closed" Command="{Binding ReopenCommand}"/>
            </MenuFlyout>
          </MenuFlyoutSubItem>
        </MenuFlyout>
      </MenuBarItem>
      <MenuBarItem Title="Edit">
        <MenuFlyout>
          <MenuFlyoutItem Text="Undo"  Hint="Ctrl+Z"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Cut"   Hint="Ctrl+X"/>
          <MenuFlyoutItem Text="Copy"  Hint="Ctrl+C"/>
          <MenuFlyoutItem Text="Paste" Hint="Ctrl+V"/>
        </MenuFlyout>
      </MenuBarItem>
      <!--
        File ▸ Close is a SECOND-level submenu. View ▸ Text &amp; font size ▸ Content
        font size is a THIRD-level one: the menu layer keeps a path of open rows,
        so every level gets the same hover, chevron and click handling as the
        top level.
      -->
      <MenuBarItem Title="View">
        <MenuFlyout>
          <MenuFlyoutSubItem Text="Text &amp; font size">
            <MenuFlyout>
              <MenuFlyoutSubItem Text="{Binding FontSizeLabel}">
                <MenuFlyout>
                  <MenuFlyoutItem Text="12 pt" Command="{Binding Font12Command}"/>
                  <MenuFlyoutItem Text="14 pt" Command="{Binding Font14Command}"/>
                  <MenuFlyoutItem Text="16 pt" Command="{Binding Font16Command}"/>
                  <MenuFlyoutItem Text="18 pt" Command="{Binding Font18Command}"/>
                </MenuFlyout>
              </MenuFlyoutSubItem>
            </MenuFlyout>
          </MenuFlyoutSubItem>
        </MenuFlyout>
      </MenuBarItem>
      <MenuBarItem Title="Help">
        <MenuFlyout>
          <MenuFlyoutItem Text="About Werfs"/>
        </MenuFlyout>
      </MenuBarItem>
    </MenuBar>

    <!-- ============ 2. Command bar ============ -->
    <!-- Deliberately more buttons than fit in a narrow window: that is what makes
         the overflow (…) reachable by simply shrinking the window. -->
    <CommandBar Grid.Row="1" Height="44">
      <AppBarButton Icon="✚" Label="New"    Style="{StaticResource ToolButton}"
                    Command="{Binding NewCommand}" ToolTip="New document"/>
      <AppBarButton Icon="▤" Label="Open"   Style="{StaticResource ToolButton}"
                    Command="{Binding OpenCommand}" ToolTip="Open a file"/>
      <AppBarButton Icon="▼" Label="Save"   Style="{StaticResource ToolButton}"
                    IsEnabled="{Binding CanSave}"
                    Command="{Binding SaveCommand}" ToolTip="Save the active document"/>
      <AppBarButton Icon="✕" Label="Close"  Style="{StaticResource ToolButton}"
                    Command="{Binding CloseTabCommand}" ToolTip="Close the active tab"/>
      <AppBarButton Icon="↺" Label="Reopen" Style="{StaticResource ToolButton}"
                    Command="{Binding ReopenCommand}" ToolTip="Reopen the last closed document"/>
    </CommandBar>

    <!-- ============ 3 + 4. Tabs holding the editor area ============ -->
    <!--
      The tab strip is data-driven: ItemsSource is the document list, SelectedIndex
      is the active document, CloseRequested is how the × asks for permission. The
      single child below is the CONTENT of the selected tab; switching tabs rebinds
      it to that tab's document.
    -->
    <TabView Grid.Row="2" ItemsSource="{Binding Documents}"
             SelectedIndex="{Binding ActiveIndex, Mode=TwoWay}"
             CloseRequested="{Binding CloseRequested, Mode=TwoWay}"
             AddCommand="{Binding NewCommand}"
             Background="CardBackground" Padding="0" Height="420">
      <Grid RowDefinitions="*,Auto" ColumnDefinitions="1*" Padding="14">
        <Border Grid.Row="0" Style="{StaticResource EditorSurface}">
          <!-- TwoWay: typing reaches the document, and switching tabs pushes the new
               document's text back into this box. Height="0" lets the Border stretch
               it; a MinHeight keeps a usable box even in a very short window. -->
          <TextBox Text="{Binding ActiveContent, Mode=TwoWay}"
                   PlaceholderText="Start typing…" Height="0" MinHeight="120"
                   AcceptsReturn="True" FontSize="{Binding EditorFontSize}"/>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding ActivePath}" Style="{StaticResource Caption}"
                   Padding="0,8,0,0"/>
      </Grid>
    </TabView>

    <!-- ============ 5. Status line ============ -->
    <Border Grid.Row="3" Style="{StaticResource Surface}" BorderThickness="0,1,0,0"
            Padding="{StaticResource StatusPad}">
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"/>
    </Border>

    <!-- ============ 6. Unsaved-changes prompt ============ -->
    <!--
      Declared once, shown on demand. IsOpen is TwoWay so the ViewModel opens it (a
      close was requested for a dirty document) and the dialog reports back when a
      button is chosen; Result carries which one.

      The primary button ("Save") is the default, so Enter saves; Escape lands on
      "Cancel", never on "Don't save". A prompt whose keyboard shortcut silently
      discarded work would be a trap.

      This element reserves no space: a ContentDialog is not in the layout flow, it
      is an overlay owned by the root (see OverlayLayer in Core.h).
    -->
    <ContentDialog x:Name="UnsavedPrompt"
                   Title="{Binding PromptTitle}"
                   Message="{Binding PromptMessage}"
                   IsOpen="{Binding PromptOpen, Mode=TwoWay}"
                   Result="{Binding PromptResult, Mode=TwoWay}"
                   PrimaryButtonText="Save"
                   SecondaryButtonText="Don't save"
                   CloseButtonText="Cancel"/>
  </Grid>
</Page>
