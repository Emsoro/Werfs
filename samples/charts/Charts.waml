<?waml version="0.1"?>
<!--
  samples/charts — a LIVE chart, and why downsampling is not optional.

  The page's subject is a moving signal, not a still picture. A ring buffer holds a
  fixed 1,000,000 points; new samples arrive every frame and the oldest are
  overwritten, so the window slides left across the signal while its cost stays
  constant. The frame rate is drawn in the plot's top-right corner by the control
  itself, measured from real paint intervals.

  Everything else on the page exists to make that claim checkable:

    section 2  the same window with downsampling OFF. The chart becomes a wall of
               line segments and the fps readout drops -- on the same data, in the
               same layout.
    section 3  a bar chart on discrete categories: the ordinary case, where
               nothing needs reducing.

  Bound to sample::ChartsVm in ChartsVm.h.
-->
<Page Background="AppBackground" Padding="0">
  <ScrollViewer>
    <StackPanel Orientation="Vertical" Margin="24" Spacing="18">

      <!-- ================= Header ================= -->
      <TextBlock Text="Live Charts &amp; Downsampling" FontSize="30" FontWeight="SemiBold"
                 Foreground="TextPrimary"/>
      <TextBlock Text="A million points that keep moving. New samples arrive every frame and the oldest are dropped, so the window costs the same after an hour as it does after a second — and the frame rate in the corner is measured from the paint itself, not assumed."
                 FontSize="13" Foreground="TextSecondary" TextWrapping="Wrap"/>

      <!-- ================= 1. The live window ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="1 · 1,000,000 points, sliding left" FontSize="17"
                     FontWeight="SemiBold" Foreground="TextPrimary"/>
          <TextBlock Text="{Binding ModeLabel}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>

          <!--
            ShowFps draws the frame rate inside the plot, top-right. The control owns
            this because only the control knows when a frame was painted; a page that
            computed fps from its own timer would be reporting the timer.
          -->
          <Chart Series="{Binding Stream}" Height="320" AutoFit="True"
                 ShowFps="{Binding ShowFps}"
                 Downsample="{Binding DownsampleMode}"
                 DrawnPoints="{Binding DrawnPoints, Mode=TwoWay}"
                 SourcePoints="{Binding SourcePoints, Mode=TwoWay}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding ToggleStreamText}" Command="{Binding ToggleStreamCommand}"/>
            <Button Content="Downsampling ON (LTTB)" Command="{Binding DownsampleOnCommand}"/>
            <Button Content="Downsampling OFF" Command="{Binding DownsampleOffCommand}"/>
            <Button Content="Reset window" Command="{Binding ResetCommand}"/>
          </StackPanel>

          <!-- The numbers below are resolved by the chart from its budget and data. -->
          <TextBlock Text="{Binding Timing}" FontSize="13" FontWeight="SemiBold"
                     Foreground="TextPrimary" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding StreamStateLabel}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding StreamLabel}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FrameBudgetNote}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ================= 2. Frame measurement ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="2 · The same window, measured both ways" FontSize="17"
                     FontWeight="SemiBold" Foreground="TextPrimary"/>
          <TextBlock Text="Runs the live window through the same plot twice, reduced and not, and times a full frame into the framework's software rasterizer. The software backend is used because it needs no window or GPU, so the number is the same in CI as on a desktop — and it is the slower backend, so the ratio is conservative."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FrameRateLabel}" FontSize="13" FontWeight="SemiBold"
                     Foreground="TextPrimary" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FrameRateDetail}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ================= 3. Category bar chart ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="3 · Bar chart on discrete categories" FontSize="17"
                     FontWeight="SemiBold" Foreground="TextPrimary"/>
          <TextBlock Text="{Binding CategoryLabel}" FontSize="12" Foreground="TextSecondary"
                     TextWrapping="Wrap"/>
          <TextBlock Text="The same one-million-point window under each mode. &quot;None&quot; is a full million segments per frame; the three reducing modes converge on roughly one point per pixel, which is why they finish and it does not."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>
          <Chart Series="{Binding CategorySeries}" Height="220" AutoFit="True"
                 Downsample="None" PlotKind="Bar"/>
        </StackPanel>
      </Border>

      <!-- ================= Footer ================= -->
      <TextBlock Text="{Binding PointsLabel}" FontSize="12" Foreground="TextSecondary"
                 TextWrapping="Wrap" Padding="0,0,0,4"/>
      <TextBlock Text="Every number on this page comes from the control's own counters, and the frame rate from the interval between real paints. A claim about frame cost that is not measured by the thing doing the drawing is a claim about nothing."
                 FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap" Padding="0,0,0,16"/>

    </StackPanel>
  </ScrollViewer>
</Page>
