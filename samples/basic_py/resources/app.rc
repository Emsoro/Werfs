// SPDX-License-Identifier: MIT
// Resources for waml_basic_py.exe. The manifest is NOT here: it goes through
// the linker's /MANIFESTINPUT: so trustInfo is injected (see CODE_PLAN §7.8).
// The markup is deliberately NOT embedded -- main.py passes its path to the
// host, so the same loose file works for python main.py and for the exe.

IDI_APP  ICON  "app.ico"

1 VERSIONINFO
 FILEVERSION    0,13,2,0
 PRODUCTVERSION 0,13,2,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Werfs Project"
            VALUE "FileDescription",  "Werfs sample: Python-driven MVVM"
            VALUE "FileVersion",      "0.14.1.0"
            VALUE "InternalName",     "waml_basic_py"
            VALUE "LegalCopyright",   "MIT License. Copyright (c) 2026 Werfs Project."
            VALUE "OriginalFilename", "waml_basic_py.exe"
            VALUE "ProductName",      "Werfs Samples"
            VALUE "ProductVersion",   "0.14.1.0"
            VALUE "Comments",         "Python ViewModel, C++ UI engine, stable-ABI extension."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
