// SPDX-License-Identifier: MIT
// Resource script: packages the WAML documents, the icon, the manifest and the
// VERSIONINFO block into the executable.
//
// Paths are resolved by rc.exe against this file's directory (samples/gallery/
// resources/), so the payload sits one level up in the sample folder itself.
// Keeping markup lookup relative to the .rc lets the build invoke rc.exe from
// any working directory.
#include "Resource.h"

// ---------------------------------------------------------------------------
// Application icon.
// ---------------------------------------------------------------------------
IDI_APP  ICON  "app.ico"

// ---------------------------------------------------------------------------
// WAML documents.
//
// Compiled as RCDATA under a private type name so nothing else interprets them.
// Adding a page = one line here + one id in Resource.h; the loader enumerates
// the type at runtime, so the C++ side needs no list of its own.
// ---------------------------------------------------------------------------
IDR_WAML_GALLERY  WAML_DOC  "../Gallery.waml"

// ---------------------------------------------------------------------------
// Manifest: NOT placed in the .rc.
//
// If a manifest resource is compiled into the .res, link.exe sees it and skips
// generating its own -- which silently drops the trustInfo block it would have
// added, and the exe launches as a "legacy app" (SmartScreen unknown-app path).
//
// The correct route is the linker's /MANIFESTINPUT: option (what MSBuild's
// <AdditionalManifestFiles> maps to). The linker then generates the manifest,
// injects trustInfo/requestedExecutionLevel itself, and merges our settings on
// top. See build.bat :do_demo and the other link steps.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// VERSIONINFO (the "Details" tab in file properties).
//
// The leading `1` is the resource id and is mandatory: without a numeric id the
// block is not addressable as RT_VERSION/VS_VERSION_INFO and the shell shows no
// version information at all (the exe still links and runs, so the mistake is
// silent).
//
// Version numbers come from Resource.h so the resource and any C++ code that
// reports its version cannot drift apart.
// ---------------------------------------------------------------------------
1 VERSIONINFO
 FILEVERSION    WUI_VERSION_COMMA
 PRODUCTVERSION WUI_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L        // VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L    // VOS_NT_WINDOWS32
 FILETYPE       0x1L        // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0409 = en-US, 0x04B0 = Unicode. Keep this pair in sync with
        // VarFileInfo\Translation below.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Win32UI Project"
            VALUE "FileDescription",  "WAML / MVVM self-drawn UI spike"
            VALUE "FileVersion",      WUI_VERSION_STR
            VALUE "InternalName",     "waml_demo"
            VALUE "LegalCopyright",   "MIT License. Copyright (c) 2026 Win32UI Project."
            VALUE "OriginalFilename", "waml_demo.exe"
            VALUE "ProductName",      "Win32UI WAML Spike"
            VALUE "ProductVersion",   WUI_VERSION_STR
            VALUE "Comments",         "Technical spike: WAML markup + MVVM bindings on a D2D self-drawn UI."
#if defined(WUI_BUILD_COMMIT)
            VALUE "BuildCommit",      WUI_BUILD_COMMIT
#endif
#if defined(WUI_BUILD_CONFIG)
            VALUE "BuildConfig",      WUI_BUILD_CONFIG
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
