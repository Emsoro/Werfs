<?waml version="0.1"?>
<!--
  Spike sample: exercises every feature the WAML subset claims to support.
  Bound to SnapshotVm in tools/Snapshot.cpp:
    Title, Count, Name, ShowSuggestions, Items, IncrementCommand, DecrementCommand
  Item objects expose Title and Index.
-->
<Page Background="AppBackground" Padding="0">
  <StackPanel Orientation="Vertical" Margin="24" Spacing="12">

    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
               Foreground="TextPrimary"/>

    <TextBlock Text="OneWay + StringFormat below; TwoWay on the text box." FontSize="13"
               Foreground="TextSecondary"/>

    <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
            CornerRadius="8" Padding="16">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="-" Command="{Binding DecrementCommand}" Width="36"/>
        <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}" FontSize="16"
                   FontWeight="Medium" MinWidth="96"/>
        <Button Content="+" Command="{Binding IncrementCommand}" Width="36"/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Vertical" Spacing="6">
      <TextBlock Text="Name (TwoWay, PropertyChanged)" FontSize="12" Foreground="TextSecondary"/>
      <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Type a name"/>
    </StackPanel>

    <CheckBox Content="Show suggestions" IsChecked="{Binding ShowSuggestions, Mode=TwoWay}"/>

    <TextBlock Text="Items (DataTemplate, ObservableList)" FontSize="12"
               Foreground="TextSecondary"/>
    <ListBox ItemsSource="{Binding Items}" ItemHeight="28" MaxHeight="196"
             Background="CardBackground">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
            <TextBlock Text="{Binding Index, StringFormat='#{0}'}" MinWidth="28"
                       Foreground="TextSecondary"/>
            <TextBlock Text="{Binding Title}" Foreground="TextPrimary"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock Text="Escaped markup literal:" FontSize="12" Foreground="TextSecondary"/>
        <TextBlock Text="{}{Binding NotABinding}" FontSize="13"/>
        <TextBlock Text="Color tokens + hex both accepted &#38; entities too." FontSize="12"
                   Foreground="#6B6B6B"/>
      </StackPanel>
    </Border>

  </StackPanel>
</Page>
