<?waml version="0.1"?>
<!--
  samples/theming — one page, two palettes.

  Every colour on this page is either a semantic token (follows the theme) or a
  literal (does not). The switch is an ordinary ViewModel bool; the host watches
  it and repaints with the other palette, so the markup never mentions a theme.

  Bound to sample::ThemingVm in ThemingVm.h.
-->
<Page Background="AppBackground" Padding="0">
  <ScrollViewer>
    <StackPanel Orientation="Vertical" Margin="24" Spacing="16">

      <!-- ================= Header ================= -->
      <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold"
                 Foreground="TextPrimary"/>
      <TextBlock Text="{Binding Blurb}" FontSize="13" Foreground="TextSecondary"
                 TextWrapping="Wrap"/>

      <!-- ================= 1. The switch ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="1 · Switch the theme" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="The button flips IsDarkTheme in the ViewModel. The host watches that property and chooses the palette; the page itself only names tokens."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleThemeCommand}"/>
            <TextBlock Text="{Binding ThemeLabel}" FontSize="13" Foreground="TextSecondary"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ================= 2. The tokens ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="2 · The palette" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="Each chip shows one token's colour in the current theme. These are the names WAML uses everywhere instead of hex values."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <WrapPanel Spacing="8">
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="AppBackground"
                        BorderBrush="CardBorder" BorderThickness="1"/>
                <TextBlock Text="AppBackground" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="CardBackground"
                        BorderBrush="CardBorder" BorderThickness="1"/>
                <TextBlock Text="CardBackground" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="CardBorder"/>
                <TextBlock Text="CardBorder" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="TextPrimary"/>
                <TextBlock Text="TextPrimary" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="TextSecondary"/>
                <TextBlock Text="TextSecondary" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="TextDisabled"/>
                <TextBlock Text="TextDisabled" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="Accent"/>
                <TextBlock Text="Accent" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="TextOnAccent"
                        BorderBrush="CardBorder" BorderThickness="1"/>
                <TextBlock Text="TextOnAccent" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="ControlFill"
                        BorderBrush="CardBorder" BorderThickness="1"/>
                <TextBlock Text="ControlFill" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="ControlFillHover"/>
                <TextBlock Text="ControlFillHover" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="ControlFillPressed"/>
                <TextBlock Text="ControlFillPressed" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
            <Border Width="210" Padding="6" Background="ControlFill" CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="3" Background="Selection"
                        BorderBrush="CardBorder" BorderThickness="1"/>
                <TextBlock Text="Selection" FontSize="12" Foreground="TextPrimary"/>
              </StackPanel>
            </Border>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ================= 3. Token vs literal ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="3 · Token versus literal" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="Left is a hard-coded red; right is the Accent token. Switch the theme: the red is deliberately unchanged, the accent is not."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
            <Border Grid.Column="0" Background="#E53935" CornerRadius="6" Padding="14">
              <TextBlock Text="Literal #E53935 — identical in both themes" FontSize="12"
                         Foreground="#FFFFFF" TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Column="1" Background="Accent" CornerRadius="6" Padding="14">
              <TextBlock Text="Token Accent — changes with the theme" FontSize="12"
                         Foreground="TextOnAccent" TextWrapping="Wrap"/>
            </Border>
          </Grid>

          <TextBlock Text="A literal is the escape hatch for a brand colour that must not change. Everything structural — backgrounds, borders, text — should be a token, or the page will look wrong in one of the two themes."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ================= Footer ================= -->
      <TextBlock Text="12 semantic tokens, two palettes, one page. See samples/binding for the other half of MVVM."
                 FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"
                 Padding="0,0,0,16"/>

    </StackPanel>
  </ScrollViewer>
</Page>
