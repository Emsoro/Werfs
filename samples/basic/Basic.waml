<?waml version="0.1"?>
<!--
  samples/basic — the five basic controls, one data source.

  This is the page a newcomer reads first, so it stays deliberately small: no
  lists, no templates, and layout only as much as needed to stack cards. Each
  card teaches exactly one control and one binding behaviour.

  Bound to sample::BasicViewVm in BasicVm.h.
-->
<Page Background="AppBackground" Padding="0">
  <ScrollViewer>
    <StackPanel Orientation="Vertical" Margin="24" Spacing="16">

      <!-- ================= Header ================= -->
      <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold"
                 Foreground="TextPrimary"/>
      <TextBlock Text="{Binding Blurb}" FontSize="13" Foreground="TextSecondary"
                 TextWrapping="Wrap"/>

      <!-- ================= 1. TextBlock ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="8">
          <TextBlock Text="1 · TextBlock" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="Text, FontSize and Foreground are set in markup; this line wraps because TextWrapping=&quot;Wrap&quot; is on."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <TextBlock Text="Normal weight, 14pt, secondary colour." FontSize="14"
                     Foreground="TextSecondary"/>
          <TextBlock Text="Semibold weight, 18pt, primary colour." FontSize="18"
                     FontWeight="SemiBold" Foreground="TextPrimary"/>
          <TextBlock Text="Accent colour, 14pt." FontSize="14" Foreground="Accent"/>
        </StackPanel>
      </Border>

      <!-- ================= 2. Button + OneWay count ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="2 · Button and Command" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="{Binding ClickSummary}" FontSize="12"
                     Foreground="TextSecondary" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Click me" Command="{Binding ClickCommand}"/>
            <Button Content="Reset" Command="{Binding ResetCommand}"/>
            <!-- OneWay: the label follows the VM, and cannot write back to it. -->
            <TextBlock Text="{Binding ClickCount, StringFormat='clicks: {0}'}"
                       FontSize="13" Foreground="TextSecondary"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ================= 3. TextBox + TwoWay ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="3 · TextBox with TwoWay binding" FontSize="17"
                     FontWeight="SemiBold" Foreground="TextPrimary"/>
          <TextBlock Text="Type in the box: the echo below is a second binding to the same property, so it updates as you type."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <TextBox Text="{Binding Greeting, Mode=TwoWay}"
                   PlaceholderText="Type something…"/>
          <TextBlock Text="{Binding Greeting, StringFormat='echo: {0}'}" FontSize="13"
                     Foreground="TextSecondary" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ================= 4. CheckBox + derived text ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <TextBlock Text="4 · CheckBox" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="The box writes its state back to the ViewModel; the caption below is derived from it."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <CheckBox Content="I have read enough to start" IsChecked="{Binding IsAgreed}"/>
          <TextBlock Text="{Binding AgreementText}" FontSize="13"
                     Foreground="TextSecondary"/>
          <!-- Visibility + converter: the confirmation row exists only after
               the box is ticked. Convince yourself by watching the card
               shrink -- Collapsed takes no space, it is not just hidden. -->
          <Border Background="Accent" CornerRadius="4" Padding="10"
                  Visibility="{Binding IsAgreed, Converter=BoolToVisibility}">
            <TextBlock Text="Confirmed. This row collapsed away entirely until you ticked the box."
                       FontSize="12" Foreground="TextOnAccent" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ================= 5. Border ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="8">
          <TextBlock Text="5 · Border" FontSize="17" FontWeight="SemiBold"
                     Foreground="TextPrimary"/>
          <TextBlock Text="Every card on this page is a Border: background, brush, thickness, radius and padding."
                     FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"/>

          <Border Background="ControlFill" BorderBrush="CardBorder" BorderThickness="1"
                  CornerRadius="0" Padding="12">
            <TextBlock Text="Sharp corners (CornerRadius=0), filled background"
                       FontSize="13" Foreground="TextPrimary"/>
          </Border>
          <Border Background="Accent" CornerRadius="12" Padding="12">
            <TextBlock Text="Accent fill, rounded 12, no border" FontSize="13"
                       Foreground="TextOnAccent"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ================= Inputs that hold a value ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Toggles and values" FontSize="15" FontWeight="SemiBold"
                     Padding="0,0,0,10"/>

          <!-- A toggle button keeps its state visible; the ViewModel owns it. -->
          <ToggleButton Content="Bold" IsChecked="{Binding IsBold, Mode=TwoWay}"
                        HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding BoldStatus}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,6,0,12"/>

          <!-- A switch reads faster than a checkbox at small sizes. -->
          <ToggleSwitch Content="Notifications" IsChecked="{Binding IsNotifying, Mode=TwoWay}"
                        HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding NotifyStatus}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,6,0,12"/>

          <!-- Slider: a real range, snapped to whole steps. -->
          <TextBlock Text="Volume" FontSize="12" Foreground="TextSecondary"/>
          <Slider Minimum="0" Maximum="10" StepFrequency="1"
                  Value="{Binding Volume, Mode=TwoWay}" Height="36"/>
          <TextBlock Text="{Binding VolumeText}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,2,0,12"/>

          <!-- Radio group: exclusive across the whole page, not per panel. -->
          <TextBlock Text="Density" FontSize="12" Foreground="TextSecondary" Padding="0,0,0,4"/>
          <RadioButton Content="Comfortable" GroupName="density"
                       IsChecked="{Binding IsComfortable, Mode=TwoWay}"/>
          <RadioButton Content="Compact" GroupName="density"
                       IsChecked="{Binding IsCompact, Mode=TwoWay}"/>

          <!-- Number and masked text fields. -->
          <TextBlock Text="Quantity" FontSize="12" Foreground="TextSecondary" Padding="0,12,0,4"/>
          <NumberBox Text="{Binding Quantity, Mode=TwoWay}" IsValid="{Binding IsQuantityValid}"
                     Width="120" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding QuantityStatus}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,4,0,12"/>

          <TextBlock Text="Passphrase" FontSize="12" Foreground="TextSecondary" Padding="0,0,0,4"/>
          <PasswordBox Text="{Binding Passphrase, Mode=TwoWay}" Width="200"
                       HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding PassphraseStatus}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- ================= Status and shapes ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Status and shapes" FontSize="15" FontWeight="SemiBold"
                     Padding="0,0,0,10"/>

          <TextBlock Text="Progress" FontSize="12" Foreground="TextSecondary"/>
          <ProgressBar Value="{Binding Progress}" Height="6" Margin="0,6,0,10"/>

          <!-- A ring animates the same value as an arc; both read the same property. -->
          <StackPanel Orientation="Horizontal">
            <ProgressRing Value="{Binding Progress}" Size="36" Margin="0,0,12,0"/>
            <InfoBadge Text="{Binding BadgeCount}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <PersonPicture DisplayName="{Binding UserName}" Diameter="36"
                           VerticalAlignment="Center"/>
          </StackPanel>

          <!-- InfoBar collapses entirely when dismissed: no reserved gap. -->
          <InfoBar Title="{Binding BarTitle}" Message="{Binding BarMessage}"
                   Severity="Informational" IsClosable="True"
                   IsOpen="{Binding IsBarOpen, Mode=TwoWay}" Margin="0,12,0,0"/>

          <!-- Line and Shape take the drawing primitives added for them. -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Shape Kind="Rectangle" ShapeWidth="48" ShapeHeight="24" CornerRadius="4"
                   Fill="Accent"/>
            <Shape Kind="Ellipse" ShapeWidth="24" ShapeHeight="24" Fill="CardBorder"
                   Margin="12,0,0,0"/>
            <Line StartX="0" StartY="12" EndX="60" EndY="12" StrokeThickness="2"
                  Stroke="TextSecondary" Margin="12,0,0,0"/>
          </StackPanel>

          <!-- A link that styles and behaves like one, without navigating on its own. -->
          <HyperlinkButton Content="{Binding LinkText}" Command="{Binding OpenLinkCommand}"
                           HorizontalAlignment="Left" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <!-- ================= Typography: monospace ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Monospace" FontSize="15" FontWeight="SemiBold"
                     Padding="0,0,0,10"/>
          <TextBlock Text="A code snippet only lines up in a fixed-width font. Compare:"
                     FontSize="12" Foreground="TextSecondary" Padding="0,0,0,8"/>

          <!-- Proportionally spaced: the columns below do not line up. -->
          <Border Background="AppBackground" CornerRadius="4" Padding="10">
            <TextBlock Text="name  = &quot;WAML&quot; /  value = 42 /  ready = true"
                       FontSize="13" TextWrapping="Wrap"/>
          </Border>

          <!-- Monospace: the same string, now readable as aligned columns. -->
          <Border Background="AppBackground" CornerRadius="4" Padding="10" Margin="0,8,0,0">
            <TextBlock Text="name  = &quot;WAML&quot; /  value = 42 /  ready = true"
                       FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ================= Popups: ComboBox, Flyout, ToolTip ================= -->
      <Border Background="CardBackground" BorderBrush="CardBorder" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Popups" FontSize="15" FontWeight="SemiBold" Padding="0,0,0,10"/>

          <!-- A drop-down that opens above the page, not inside the card: it must not be
               clipped by anything the card sits in. -->
          <TextBlock Text="Language" FontSize="12" Foreground="TextSecondary" Padding="0,0,0,4"/>
          <ComboBox Items="C++;C#;Rust;Python;Go" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                    HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding LanguageText}" FontSize="12" Foreground="TextSecondary"
                     Padding="0,4,0,12"/>

          <!-- A flyout holding real controls: a small form, not a menu of rows. -->
          <Flyout Content="Advanced..." HorizontalAlignment="Left">
            <StackPanel Spacing="8">
              <TextBlock Text="Wrapped in an overlay, so no card clips it." FontSize="12"
                         Foreground="TextSecondary" TextWrapping="Wrap"/>
              <ToggleSwitch Content="Wrap long lines" IsChecked="{Binding WrapLines, Mode=TwoWay}"/>
              <Button Content="Reset" Command="{Binding ResetCommand}"/>
            </StackPanel>
          </Flyout>

          <!-- A tooltip labels its child without ever intercepting a click on it. -->
          <ToolTip Text="Tooltips appear on hover and pass clicks through." Margin="0,12,0,0">
            <TextBlock Text="Hover this sentence for a hint." FontSize="13"/>
          </ToolTip>
        </StackPanel>
      </Border>

      <!-- ================= Footer ================= -->
      <TextBlock Text="That is every basic control. See samples/list for collections and layout panels."
                 FontSize="12" Foreground="TextSecondary" TextWrapping="Wrap"
                 Padding="0,0,0,16"/>

    </StackPanel>
  </ScrollViewer>
</Page>
