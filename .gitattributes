# Normalize line endings on commit, keep the working tree as-is.
#
# Why this file exists: without it, `core.autocrlf=true` on Windows rewrites
# every LF file to CRLF on checkout, so a clone produces a working tree that
# differs from the original byte-for-byte and every diff looks enormous.
# C++ sources here are LF; batch files are LF too and drive cmd.exe fine.
#
# Rule: store LF in the repository, write LF in the working tree.
* text=auto eol=lf

# Binary payloads must never be line-ending converted.
*.ico   binary
*.png   binary
*.exe   binary
*.lib   binary
*.pdb   binary

# Windows batch/cmd scripts: LF is what this repo builds with (the old
# build.bat was verified to work with LF). Pinned explicitly so no filter
# "fixes" it.
*.bat   text eol=lf
*.cmd   text eol=lf

# PowerShell: LF is fine. Windows PowerShell 5.1 and pwsh 7+ both parse LF
# scripts correctly; a UTF-8 BOM is also unnecessary since the script is
# ASCII-only. Pinned so a Windows editor cannot silently reintroduce CRLF.
*.ps1   text eol=lf
*.psm1  text eol=lf
